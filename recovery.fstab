# Android-format recovery fstab for Lava Shark 5G (LXX516)
# TARGET_RECOVERY_FSTAB -> ramdisk /system/etc/recovery.fstab (== /etc/recovery.fstab)
# Must be Android (fs_mgr) format: libfs_mgr's ReadDefaultFstab() reads this in
# recovery mode for BCB (misc) access, FBE decrypt (/data), and first-stage mounts.
# TWRP's own parser also handles this format natively.

# Bootloader / firmware
/dev/block/mmcblk0boot0          /spl          emmc   defaults          slotselect
/dev/block/mmcblk0boot1          /spl_bk       emmc   defaults          defaults
/dev/block/by-name/uboot         /uboot        emmc   defaults          slotselect
/dev/block/by-name/sml           /sml          emmc   defaults          slotselect
/dev/block/by-name/trustos       /tos          emmc   defaults          slotselect
/dev/block/by-name/teecfg        /teecfg       emmc   defaults          slotselect
/dev/block/by-name/vbmeta        /vbmeta       emmc   defaults          slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc  defaults          slotselect
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc  defaults          slotselect
/dev/block/by-name/dtbo          /dtbo         emmc   defaults          slotselect
/dev/block/by-name/vendor_boot   /vendor_boot  emmc   defaults          slotselect

# Modem / DSP
/dev/block/by-name/l_ldsp        /ltedsp       emmc   defaults          slotselect
/dev/block/by-name/l_gdsp        /ltegdsp      emmc   defaults          slotselect
/dev/block/by-name/l_modem       /ltemodem     emmc   defaults          slotselect
/dev/block/by-name/l_fixnv1      /ltefixnv1    emmc   defaults          defaults
/dev/block/by-name/l_fixnv2      /ltefixnv2    emmc   defaults          defaults
/dev/block/by-name/l_runtimenv1  /lteruntimenv1 emmc  defaults          defaults
/dev/block/by-name/l_runtimenv2  /lteruntimenv2 emmc  defaults          defaults
/dev/block/by-name/wcnmodem      /wcnmodem     emmc   defaults          slotselect
/dev/block/by-name/gnssmodem     /gnssmodem    emmc   defaults          slotselect
/dev/block/by-name/pm_sys        /pmsys        emmc   defaults          slotselect

# Boot control / misc (BCB) -- required for reboot management and decrypt
/dev/block/by-name/misc          /misc         emmc   defaults          defaults
/dev/block/by-name/boot          /boot         emmc   defaults          slotselect
/dev/block/by-name/init_boot     /init_boot    emmc   defaults          slotselect
/dev/block/by-name/persist       /persist      emmc   defaults          defaults
/dev/block/by-name/logo          /logo         emmc   defaults          defaults
/dev/block/by-name/fbootlogo     /fbootlogo    emmc   defaults          defaults

# Dynamic (super) logical partitions -- ro (erofs/ext4)
system                           /system       erofs  ro                wait,slotselect,logical
system                           /system       ext4   ro,barrier=1      wait,slotselect,logical
system_ext                       /system_ext   erofs  ro                wait,slotselect,logical
vendor                           /vendor       erofs  ro                wait,slotselect,logical
odm                              /odm          erofs  ro                wait,slotselect,logical
product                          /product      erofs  ro                wait,slotselect,logical
vendor_dlkm                      /vendor_dlkm  erofs  ro                wait,slotselect,logical
system_dlkm                      /system_dlkm  erofs  ro                wait,slotselect,logical

# Metadata / data (stock parity: checkpoint=fs, inlinecrypt)
/dev/block/by-name/metadata      /metadata     f2fs   nodev,noatime,nosuid wait,formattable,check
/dev/block/by-name/metadata      /metadata     ext4   nodev,noatime,nosuid,errors=panic wait,formattable,check
/dev/block/by-name/userdata      /data         f2fs   noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier,atgc latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable

# Storage & Cache
/dev/block/by-name/cache         /cache        ext4   defaults          wait,check
/dev/block/mmcblk1p1             /external_sd  vfat   defaults          defaults
/dev/block/sdg1                  /usb_otg      vfat   defaults          defaults
